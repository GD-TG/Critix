# Copy to .env. Use long random values; do not commit .env.
# Use URL-safe characters for the database password (letters/digits recommended).
# See docs/operations.md for local Python/Vite and Docker instructions.
# Local Docker HTTP: SITE_ADDRESS=http://localhost, APP_ORIGIN=http://localhost,
# COOKIE_SECURE=false. Compose always sets ENVIRONMENT=production.
# Current Caddyfile uses tls internal; configure public TLS before VPS deployment.
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
SESSION_SECRET=
SITE_ADDRESS=critix.example.com
APP_ORIGIN=https://critix.example.com
COOKIE_SECURE=true
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# For local Python only (Compose supplies its own DATABASE_URL):
# DATABASE_URL=postgresql+psycopg://critix:YOUR_PASSWORD@127.0.0.1:5432/critix
# ENVIRONMENT=development
# TRUST_PROXY_HEADERS=false
# For Vite use APP_ORIGIN=http://localhost:5173 and COOKIE_SECURE=false.
